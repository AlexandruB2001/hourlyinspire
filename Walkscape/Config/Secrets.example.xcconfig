// Copy to Config/Secrets.xcconfig (git-ignored) and fill in from
// Supabase Dashboard → Project Settings → API.
//
// Host only, without "https://" (xcconfig files treat "//" as a comment).
SUPABASE_HOST = your-project-ref.supabase.co
// The "anon" / publishable key. It is safe to ship in the app; row level
// security protects the data. NEVER put the service_role key here.
SUPABASE_ANON_KEY = your-anon-key

// For a local `supabase start` stack instead:
// SUPABASE_HOST = 127.0.0.1:54321
// SUPABASE_SCHEME = http
