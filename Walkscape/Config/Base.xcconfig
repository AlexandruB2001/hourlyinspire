// Shared build settings for all configurations.
//
// Supabase connection (project "walkscape"). The publishable key is meant to
// ship inside the app: row level security protects the data. Never put a
// secret / service_role key in this file.
//
// To point a build somewhere else, override these in Config/Secrets.xcconfig
// (git-ignored; see Config/Secrets.example.xcconfig). CI writes that file
// from the SUPABASE_HOST / SUPABASE_ANON_KEY repository secrets if they exist.
// Empty values run the app in local-only mode with sample friends.
SUPABASE_HOST = tsajekigvuwoeqdfwnib.supabase.co
SUPABASE_SCHEME = https
SUPABASE_ANON_KEY = sb_publishable_8vSaQhFayoptNJ9tiC-Fww_xbRiTSNc

// AdMob app "Walkscape Journey". Ad unit ids are only used in App Store
// builds; Debug, simulator and TestFlight builds always request Google's
// test ads (see AdConfig in AdService.swift), so testers can't trigger
// invalid traffic on the real account.
ADMOB_APP_ID = ca-app-pub-4649982849905794~1438124535
ADMOB_APP_OPEN_UNIT = ca-app-pub-4649982849905794/7811961193
ADMOB_REWARDED_UNIT = ca-app-pub-4649982849905794/2794156971

#include? "Secrets.xcconfig"
